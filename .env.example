# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Render injects PORT automatically in production; leave this for local dev.
PORT=4000
API_PREFIX=api
API_DEFAULT_VERSION=1
# Comma-separated list of allowed browser origins.
# Local:      http://localhost:3000
# Production: https://your-frontend.vercel.app
# NOTE: In production an empty value disables CORS entirely (no browser
# client can reach the API) — this is intentional, not a fallback.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://flowlens:flowlens@localhost:5432/flowlens_dev?schema=public
DATABASE_POOL_MAX=20

# ---------------------------------------------------------------------------
# Redis (cache + BullMQ)
# ---------------------------------------------------------------------------
# Local:      localhost
# Production: host from your managed Redis provider (Upstash, Redis Cloud,
#             Render Redis, etc.)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to true when using a managed Redis provider that requires TLS
# (Upstash, Redis Cloud, Render Redis). Leave false for local Redis.
REDIS_TLS=false
REDIS_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2

# ---------------------------------------------------------------------------
# OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# ---------------------------------------------------------------------------
# File storage (S3-compatible; also works with Cloudinary via adapter)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=s3
S3_BUCKET=flowlens-uploads-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------------
# AI providers (modular — set AI_PROVIDER to switch active provider)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GROQ_API_KEY=
WHISPER_PROVIDER=openai

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Billing (Stripe)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FlowLens AI <noreply@flowlens.ai>
