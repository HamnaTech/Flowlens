# Base URL of the FlowLens backend API, including the version prefix.
# Matches API_PREFIX + API_DEFAULT_VERSION from the backend's own .env.
#
# Local development — use the absolute URL of the running NestJS backend.
# The backend's CORS_ORIGINS includes http://localhost:3000, so when the
# Vite dev server runs on port 3000, CORS allows these requests.
VITE_API_BASE_URL=http://localhost:4000/api/v1
#
# Production (Vercel) — set this to your deployed Render backend URL:
# VITE_API_BASE_URL=https://your-render-backend.onrender.com/api/v1
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser.
# Set this in Vercel's dashboard (Settings → Environment Variables), NOT
# in a committed file.